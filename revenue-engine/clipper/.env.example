# Copy to .env for a hosted deployment. Replace every CHANGE_ME value locally; never commit real secrets.
CLIPPER_REQUIRE_AUTH=1
CLIPPER_SESSION_SECRET=CHANGE_ME_random_secret_at_least_32_characters
CLIPPER_SAAS_DB=/data/clipper-platform.sqlite3
CLIPPER_COST_PER_SOURCE_HOUR_USD=0
CLIPPER_DOMAIN=localhost

# Stripe Billing (optional until the product's price IDs and webhook are configured).
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_PRICE_STARTER=CHANGE_ME
STRIPE_PRICE_PRO=CHANGE_ME
STRIPE_SUCCESS_URL=https://localhost/billing/success
STRIPE_CANCEL_URL=https://localhost/billing/cancel

# S3-compatible private media storage (optional).
AWS_REGION=us-east-1
CLIPPER_S3_BUCKET=CHANGE_ME
CLIPPER_S3_ENDPOINT_URL=

# Protect the internal Prometheus endpoint. Keep it off public routes.
CLIPPER_METRICS_TOKEN=CHANGE_ME_random_metrics_secret

# Needed only for optional pyannote speaker diarization; accept model terms first.
HF_TOKEN=
